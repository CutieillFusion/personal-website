---
import Base from '../layouts/Base.astro';
---

<Base title="Resume — Dylan Norquist" description="Dylan Norquist's resume: ML researcher at DreamcatcherAI, M.S. Machine Learning and B.S. Computer Science at MSOE.">
  <main class="page-container">
    <header class="resume-header">
      <h1 class="page-title">Dylan Norquist</h1>
      <p class="resume-headline">
        ML Researcher at DreamcatcherAI
      </p>
      <div class="icon-links resume-socials">
        <a class="icon-link" href="mailto:business@dylannorquist.codes" aria-label="Email">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </a>
        <a class="icon-link" href="https://github.com/CutieillFusion" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
          </svg>
        </a>
        <a class="icon-link" href="https://www.linkedin.com/in/dylan-norquist-578901256/" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
          </svg>
        </a>
      </div>
    </header>

    <section class="resume-section">
      <h2 class="resume-heading">Experience</h2>

      <div class="resume-entry">
        <h3 class="resume-entry-org">DreamcatcherAI</h3>
        <div class="resume-roles">
          <div class="resume-role">
            <div class="resume-role-head">
              <div class="resume-entry-title">ML Researcher</div>
              <span class="resume-meta">Apr 2026 – Present</span>
            </div>
            <p>Making LLMs fast. Research and engineering on LLM inference performance.</p>
          </div>
        </div>
      </div>

      <div class="resume-entry">
        <h3 class="resume-entry-org">Direct Supply</h3>
        <div class="resume-roles">
          <div class="resume-role">
            <div class="resume-role-head">
              <div class="resume-entry-title">Applied AI Intern</div>
              <span class="resume-meta">Jan 2025 – Apr 2026</span>
            </div>
            <p>
              Built full-stack prototypes in Python, PostgreSQL, and React
              applying AI to problems in the elderly care industry.
              Milwaukee, WI.
            </p>
          </div>
          <div class="resume-role">
            <div class="resume-role-head">
              <div class="resume-entry-title">Data Science Intern</div>
              <span class="resume-meta">Aug 2024 – Jan 2025</span>
            </div>
          </div>
          <div class="resume-role">
            <div class="resume-role-head">
              <div class="resume-entry-title">Software Engineering Intern</div>
              <span class="resume-meta">Jun 2024 – Aug 2024</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="resume-section">
      <h2 class="resume-heading">Education</h2>

      <div class="resume-entry">
        <h3 class="resume-entry-org">Milwaukee School of Engineering</h3>
        <div class="resume-roles">
          <div class="resume-role">
            <div class="resume-role-head">
              <div class="resume-entry-title">M.S. Machine Learning</div>
              <span class="resume-meta">Aug 2025 – Aug 2026</span>
            </div>
          </div>
          <div class="resume-role">
            <div class="resume-role-head">
              <div class="resume-entry-title">B.S. Computer Science</div>
              <span class="resume-meta">Aug 2023 – May 2026</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="resume-section">
      <h2 class="resume-heading">Awards &amp; Research</h2>

      <div class="resume-entry">
        <div class="resume-entry-head">
          <h3 class="resume-entry-org">SMEARGLE</h3>
          <span class="resume-meta">2026</span>
        </div>
        <div class="resume-entry-title">2nd place — ROSIE Supercomputer Super Challenge</div>
        <p>
          Model-based speculative decoding that surpasses the previous SOTA
          (EAGLE3). Preliminary results presented at the Midwest Instruction
          and Computing Symposium (MICS 2026).
        </p>
      </div>

      <div class="resume-entry">
        <div class="resume-entry-head">
          <h3 class="resume-entry-org">Proactive Urban Forestry Management</h3>
          <span class="resume-meta">2026</span>
        </div>
        <div class="resume-entry-title">3rd place — ROSIE Supercomputer Super Challenge</div>
        <p>
          ML system for the City of Milwaukee that prioritizes tree pruning,
          shifting the city's forestry workflow from reactive to proactive.
          Mentored Xander Ede, Chukwuma Chukwuma-Ugwu, and Joshua Myers, who
          presented the work at MICS 2026.
        </p>
      </div>
    </section>

  </main>
</Base>

<style>
  .resume-header {
    margin-bottom: 32px;
  }

  .resume-headline {
    color: var(--fg-muted);
    margin-bottom: 12px;
  }

  .resume-socials {
    margin-left: -8px;
  }

  .resume-section {
    margin-bottom: 40px;
  }

  .resume-heading {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 20px;
  }

  .resume-entry {
    margin-bottom: 20px;
  }

  .resume-entry:last-child {
    margin-bottom: 0;
  }

  .resume-entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .resume-entry-head .resume-entry-org {
    min-width: 0;
  }

  .resume-entry-org {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .resume-entry-title {
    font-size: 0.95rem;
    color: var(--fg-muted);
    margin-top: 2px;
    margin-bottom: 6px;
  }

  .resume-meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-soft);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .resume-entry p {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }

  .resume-entry > .resume-entry-org {
    margin-bottom: 4px;
  }

  .resume-roles {
    margin-top: 8px;
    padding-left: 16px;
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .resume-role-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .resume-role-head .resume-entry-title {
    flex: 1 1 auto;
    min-width: 0;
  }

  .resume-role .resume-entry-title {
    margin-top: 0;
    margin-bottom: 4px;
    color: var(--fg);
  }

</style>
