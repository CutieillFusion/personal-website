---
import Base from '../layouts/Base.astro';

const posts = [
  {
    date: 'April 25, 2026',
    dateISO: '2026-04-25',
    title: 'Hello, world',
    description:
      'A short note on why this site exists and what I plan to write about here.',
    href: '/blog/hello-world',
  },
];
---

<Base title="Blog — Dylan Norquist" description="Posts by Dylan Norquist on machine learning, software, and side projects.">
  <main class="page-container">
    <h1 class="page-title">Blog</h1>
    <p class="page-sub">Notes on machine learning, software, and side projects.</p>

    <div class="posts-list">
      {posts.map((post) => (
        <a href={post.href} class="post-card">
          <time datetime={post.dateISO} class="post-date">{post.date}</time>
          <h2 class="post-title">{post.title}</h2>
          <p class="post-desc">{post.description}</p>
        </a>
      ))}
    </div>
  </main>
</Base>

<style>
  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .post-card {
    display: block;
    padding: 24px 0;
    border-top: 1px solid var(--border);
    transition: opacity 0.15s;
  }

  .post-card:last-child {
    border-bottom: 1px solid var(--border);
  }

  .post-card:hover .post-title {
    color: var(--accent);
  }

  .post-date {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-soft);
    margin-bottom: 8px;
  }

  .post-title {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
    color: var(--fg);
    transition: color 0.15s;
  }

  .post-desc {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
</style>
