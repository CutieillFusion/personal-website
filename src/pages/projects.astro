---
import Base from '../layouts/Base.astro';

const projects = [
  {
    title: 'SMEARGLE',
    description: 'Model-based speculative decoding that surpasses the previous SOTA (EAGLE3).',
    tags: ['Python', 'Research', 'LLM'],
    href: '/projects/smeargle',
  },
  {
    title: 'Grimoire',
    description: 'A coding-agent CLI built with Textual, compatible with a Claude subscription.',
    tags: ['Python', 'CLI', 'AI'],
    href: '/projects/grimoire',
  },
  {
    title: 'Fusion',
    description: 'A programming language with an LSP and VSCode extension, capable of training a microGPT.',
    tags: ['C++', 'Compiler', 'ML'],
    href: '/projects/fusion',
  },
  {
    title: 'Gradtuity',
    description: 'A from-scratch tensor autograd engine using Triton GPU kernels.',
    tags: ['Python', 'Triton', 'ML'],
    href: '/projects/gradtuity',
  },
  {
    title: 'Neural Network From Scratch',
    description: 'A 28×28 grayscale digit recognizer written from scratch in C++.',
    tags: ['C++', 'ML', 'Learning'],
    href: '/projects/neural-network-from-scratch',
  },
  {
    title: 'Weather App',
    description: 'A KATA problem from Direct Supply.',
    tags: ['Python', 'KATA'],
    href: '/projects/weather-app',
  },
  {
    title: '3D Game Engine',
    description: 'An in-progress 3D game engine, currently swapping its render backend.',
    tags: ['C++', 'Game Engine'],
    href: '/projects/3d-game-engine',
  },
];
---

<Base title="Projects - Dylan Norquist" description="Projects Dylan Norquist has built or is currently working on.">
  <main class="page-container">
    <h1 class="page-title">Projects</h1>
    <p class="page-sub">A handful of things I've built. More to come.</p>

    <div class="projects-list">
      {projects.map((p) => (
        <a href={p.href} class="project-card">
          <h2 class="project-title">{p.title}</h2>
          <p class="project-desc">{p.description}</p>
          <div class="project-tags">
            {p.tags.map((t) => <span class="project-tag">{t}</span>)}
          </div>
        </a>
      ))}
    </div>
  </main>
</Base>

<style>
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .project-card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    background: var(--bg-elevated);
    transition: border-color 0.15s, transform 0.15s;
  }

  .project-card:hover {
    border-color: rgba(17, 17, 17, 0.2);
    transform: translateY(-1px);
  }

  .project-card:hover .project-title {
    color: var(--accent);
  }

  .project-title {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
    color: var(--fg);
    transition: color 0.15s;
  }

  .project-desc {
    color: var(--fg-muted);
    font-size: 0.95rem;
    margin-bottom: 12px;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 3px 8px;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--fg-soft);
  }
</style>
