---
import Base from '../../layouts/Base.astro';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Hello, world",
  "description": "A short note on why this site exists and what I plan to write about here.",
  "datePublished": "2026-04-25",
  "author": { "@type": "Person", "name": "Dylan Norquist" },
  "url": "https://dylannorquist.codes/blog/hello-world",
  "mainEntityOfPage": "https://dylannorquist.codes/blog/hello-world"
};
---

<Base title="Hello, world — Dylan Norquist" description="A short note on why this site exists and what I plan to write about here.">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <main class="page-container">
    <article>
      <a href="/blog" class="back-link">&larr; Back to blog</a>

      <div class="post-meta">
        <time datetime="2026-04-25">April 25, 2026</time>
      </div>

      <h1 class="page-title">Hello, world</h1>

      <div class="prose">
        <p>
          I rebuilt this site from scratch. The previous version was a Next.js
          app with a Postgres-backed CMS, an admin panel, an LLM chatbot, and
          a fair amount of plumbing for what amounted to a personal page. It
          was fun to build, but it stopped being fun to maintain.
        </p>
        <p>
          The new version is plain Astro. Posts are hand-authored
          <code>.astro</code> files. There is no database, no auth, and no API
          surface. Every page is static HTML at build time.
        </p>

        <h2>What I'll write about</h2>
        <p>
          Mostly machine learning notes, the occasional side project, and
          whatever I'm currently thinking about at MSOE or at work. If a post
          would survive being half-finished and unpolished, it'll probably
          show up here.
        </p>
      </div>
    </article>
  </main>
</Base>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-soft);
    margin-bottom: 32px;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-soft);
    margin-bottom: 12px;
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 2px 6px;
    background: rgba(17, 17, 17, 0.05);
    border-radius: 4px;
  }
</style>
